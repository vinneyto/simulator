{
  "name": "simulator-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @simulator/web --",
    "build": "npm run build --workspace @simulator/web --",
    "start": "npm run start --workspace @simulator/web --",
    "lint": "npm run lint --workspace @simulator/web --",
    "test": "npm run test --workspace @simulator/web --",
    "typecheck": "npm run typecheck --workspace @simulator/web --",
    "api:generate": "npm run api:generate --workspace @simulator/web --",
    "api:check": "npm run api:check --workspace @simulator/web --",
    "format": "npm run format --workspace @simulator/web --",
    "format:check": "npm run format:check --workspace @simulator/web --"
  }
}
